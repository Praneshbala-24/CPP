#include <iostream>
#include <queue>
#include <string>
using namespace std;
int main() {
    int n;
    cin >> n;
    cin.ignore(); 
    queue<int> q;
    bool isValid = true;
    for (int i = 0; i < n; ++i) {
        string op;
        getline(cin, op);

        if (op.find("ENQUEUE") == 0) {
            int x = stoi(op.substr(8));
            q.push(x);
        } else if (op.find("DEQUEUE") == 0) {
            int x = stoi(op.substr(8));
            if (q.empty() || q.front() != x) {
                isValid = false;
                break;
            }
            q.pop();
        }
    }

    cout << (isValid ? "Valid" : "Invalid") << endl;

    return 0;
}