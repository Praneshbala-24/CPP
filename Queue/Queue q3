#include <iostream>
#include <queue>
#include <string>
using namespace std;
void generateBinaryNumbers(int N) {
    queue<string> q;
    q.push("1"); 

    for (int i = 0; i < N; ++i) {
        string current = q.front();
        q.pop();
        cout << current << " ";
        q.push(current + "0");
        q.push(current + "1");
    }
}
int main() {
    int N;
    cin >> N;
    generateBinaryNumbers(N);
    return 0;
}